{
  "name": "dreamy-stories-admin",
  "private": true,
  "version": "1.0.0",
  "description": "Админ-панель для контента Dreamy Bedtime Stories (сказки и колыбельные по гео)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@mantine/core": "8.3.18",
    "@mantine/dropzone": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@mantine/modals": "8.3.18",
    "@mantine/notifications": "8.3.18",
    "@tabler/icons-react": "3.50.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "music-metadata": "12.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
